rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Firm Events (Lectures, Gala, Seminars)
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 2. Event RSVPs Collection
    match /rsvps/{rsvpId} {
      allow read, create, update: if true;
    }
    
    // 3. Users, Attorney Directory & Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /userProfiles/{profileId} {
      allow read, write: if true;
    }

    match /team_members/{memberId} {
      allow read, write: if true;
    }

    // 4. Team Onboarding Invitations
    match /invitations/{invitationId} {
      allow read, write: if true;
    }

    match /invitations_by_email/{emailKey} {
      allow read, write: if true;
    }

    // 5. Legal Matters, Task Queue & Filed Documents
    match /matters/{matterId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /documents/{docId} {
      allow read, write: if true;
    }

    // 6. Real-time Messages & Audit System Logs
    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 7. Gazette Newsletter Subscribers & Dispatches
    match /newsletter_subscribers/{subId} {
      allow read, write: if true;
    }

    match /newsletters/{newsletterId} {
      allow read, write: if true;
    }

    // 8. Public Portal Submissions (Careers & Inquiries)
    match /career_applications/{appId} {
      allow read, write: if true;
    }

    match /contact_messages/{msgId} {
      allow read, write: if true;
    }

    // Default Fallback Rule for all firm documents
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}
